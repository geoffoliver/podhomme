{
  "name": "podhomme",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "PORT=3030 next dev",
    "build": "next build",
    "start": "PORT=3030 next start",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "electron:compile": "tsc --project tsconfig.electron.json",
    "electron:dev": "yarn electron:compile && electron .",
    "electron:rebuild": "electron-rebuild",
    "electron:build": "yarn build && yarn electron:compile && electron-builder",
    "electron:pack": "yarn build && yarn electron:compile && electron-builder --dir"
  },
  "ts-node": {
    "project": "tsconfig.jest.json"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "better-sqlite3": "^12.10.0",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.7",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "me.geoffoliver.podhomme",
    "productName": "Podhomme",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.ts",
      "prisma/**/*",
      "prisma.config.ts",
      "app/generated/**/*",
      "envConfig.ts",
      "electron/main.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/android-chrome-512x512.png",
      "target": [{ "target": "dmg", "arch": ["x64"] }]
    }
  }
}
