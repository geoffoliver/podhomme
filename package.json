{
  "name": "podhomme",
  "version": "0.1.5",
  "private": true,
  "main": "electron/main.js",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ]
  },
  "scripts": {
    "dev": "PORT=3030 next dev",
    "build": "next build",
    "start": "PORT=3030 next start",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "electron:compile": "tsc --project tsconfig.electron.json",
    "electron:dev": "yarn electron:compile && electron .",
    "electron:rebuild": "electron-rebuild",
    "electron:build": "yarn build && node scripts/prepare-electron.js && yarn electron:compile && electron-builder",
    "electron:pack": "yarn build && node scripts/prepare-electron.js && yarn electron:compile && electron-builder --dir",
    "prepare": "husky"
  },
  "ts-node": {
    "project": "tsconfig.jest.json"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.7",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^16",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "me.geoffoliver.podhomme",
    "productName": "Podhomme",
    "directories": {
      "output": "dist"
    },
    "files": [
      "prisma/migrations/**/*",
      "electron/main.js",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/@electron/**",
      "!node_modules/.cache/**",
      "!node_modules/@playwright/**",
      "!node_modules/playwright-core/**",
      "!node_modules/jest/**",
      "!node_modules/jest-*/**",
      "!node_modules/@jest/**",
      "!node_modules/typescript/**",
      "!node_modules/ts-node/**",
      "!node_modules/tsx/**",
      "!node_modules/eslint/**",
      "!node_modules/eslint-*/**",
      "!node_modules/@eslint/**",
      "!node_modules/prettier/**",
      "!node_modules/prisma/**",
      "!node_modules/pino-pretty/**",
      "!node_modules/7zip-bin/**",
      "!node_modules/@esbuild/**",
      "!node_modules/@babel/**",
      "!node_modules/@testing-library/**",
      "!node_modules/@types/**",
      "!node_modules/next/**",
      "!node_modules/@next/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/tailwindcss/**",
      "!node_modules/@tailwindcss/**",
      "!node_modules/lucide-react/**",
      "!node_modules/@prisma/**",
      "!node_modules/effect/**",
      "!node_modules/@electric-sql/**",
      "!node_modules/@img/**",
      "!node_modules/@stylistic/**",
      "!node_modules/lightningcss*/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "prisma/migrations/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/android-chrome-512x512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/android-chrome-512x512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Audio",
      "icon": "public/android-chrome-512x512.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
